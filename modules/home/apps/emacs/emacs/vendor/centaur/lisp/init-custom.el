;;; Commentary:
;;
;; Customization.
;;
;; This is a fork of Centaur Emacs (upstream:
;; https://github.com/seagle0128/.emacs.d), re-themed and re-branded as
;; Flutter Emacs.  The Centaur logo and theme machinery (doom-themes,
;; circadian, auto-dark) were intentionally removed: this config loads
;; the `flutterice' theme generated by matugen (see
;; themes/flutterice-theme.el).  The package-archives mirror list is kept
;; for compatibility but is inert under Elpaca, which fetches via git.
;;

;;; Code:

;; NOTE: upstream had (eval-when-compile (require 'package)) here for the
;; package-archives defcustom below. Under Elpaca that would load
;; package.el during startup (eval-when-compile evaluates in interpreted
;; files too) and trip Elpaca's "Package.el loaded before Elpaca"
;; warning, so it's been removed. The archive machinery is inert anyway.

(defgroup flutter nil
  "Flutter Emacs customization."
  :group 'convenience)

(defcustom flutter-full-name user-full-name
  "Set user full name."
  :group 'flutter
  :type 'string)

(defcustom flutter-mail-address user-mail-address
  "Set user email address."
  :group 'flutter
  :type 'string)

(defcustom flutter-org-directory (expand-file-name "~/org")
  "Set org directory."
  :group 'flutter
  :type 'string)

(defcustom flutter-proxy "127.0.0.1:7897"
  "Set HTTP/HTTPS proxy."
  :group 'flutter
  :type 'string)

(defcustom flutter-socks-proxy "127.0.0.1:7897"
  "Set SOCKS proxy."
  :group 'flutter
  :type 'string)

(defcustom flutter-use-exec-path-from-shell
  (and (or (memq window-system '(mac ns x)) (daemonp))
       (not (bound-and-true-p ns-emacs-plus-injected-path)))
  "Use `exec-path-from-shell' or not.
If using emacs-plus with path ejection, set to nil."
  :group 'flutter
  :type 'boolean)

(defcustom flutter-icon t
  "Display icons or not."
  :group 'flutter
  :type 'boolean)

;; Emacs Lisp Package Archive (ELPA)
;; @see https://github.com/melpa/melpa and https://elpa.emacs-china.org/.
;; NOTE: kept for compatibility with Centaur's machinery; Elpaca ignores
;; `package-archives', so these mirrors are inert in Flutter Emacs.
(defcustom flutter-package-archives-alist
  (let ((proto (if (gnutls-available-p) "https" "http")))
    `((melpa    . (("gnu"    . ,(format "%s://elpa.gnu.org/packages/" proto))
                   ("nongnu" . ,(format "%s://elpa.nongnu.org/nongnu/" proto))
                   ("melpa"  . ,(format "%s://melpa.org/packages/" proto))))
      (bfsu     . (("gnu"    . ,(format "%s://mirrors.bfsu.edu.cn/elpa/gnu/" proto))
                   ("nongnu" . ,(format "%s://mirrors.bfsu.edu.cn/elpa/nongnu/" proto))
                   ("melpa"  . ,(format "%s://mirrors.bfsu.edu.cn/elpa/melpa/" proto))))
      (iscas    . (("gnu"    . ,(format "%s://mirror.iscas.ac.cn/elpa/gnu/" proto))
                   ("nongnu" . ,(format "%s://mirror.iscas.ac.cn/elpa/nongnu/" proto))
                   ("melpa"  . ,(format "%s://mirror.iscas.ac.cn/elpa/melpa/" proto))))
      (netease  . (("gnu"    . ,(format "%s://mirrors.163.com/elpa/gnu/" proto))
                   ("nongnu" . ,(format "%s://mirrors.163.com/elpa/nongnu/" proto))
                   ("melpa"  . ,(format "%s://mirrors.163.com/elpa/melpa/" proto))))
      (sjtu     . (("gnu"    . ,(format "%s://mirrors.sjtug.sjtu.edu.cn/emacs-elpa/gnu/" proto))
                   ("nongnu" . ,(format "%s://mirrors.sjtug.sjtu.edu.cn/emacs-elpa/nongnu/" proto))
                   ("melpa"  . ,(format "%s://mirrors.sjtug.sjtu.edu.cn/emacs-elpa/melpa/" proto))))
      (tuna     . (("gnu"    . ,(format "%s://mirrors.tuna.tsinghua.edu.cn/elpa/gnu/" proto))
                   ("nongnu" . ,(format "%s://mirrors.tuna.tsinghua.edu.cn/elpa/nongnu/" proto))
                   ("melpa"  . ,(format "%s://mirrors.tuna.tsinghua.edu.cn/elpa/melpa/" proto))))
      (ustc     . (("gnu"    . ,(format "%s://mirrors.ustc.edu.cn/elpa/gnu/" proto))
                   ("nongnu" . ,(format "%s://mirrors.ustc.edu.cn/elpa/nongnu/" proto))
                   ("melpa"  . ,(format "%s://mirrors.ustc.edu.cn/elpa/melpa/" proto))))))
  "A list of the package archives."
  :group 'flutter
  :type '(alist :key-type (symbol :tag "Archive group name")
                :value-type (alist :key-type (string :tag "Archive name")
                                   :value-type (string :tag "URL or directory name"))))

(defcustom flutter-package-archives 'melpa
  "Set package archives from which to fetch."
  :group 'flutter
  :set (lambda (symbol value)
         (set symbol value)
         (setq package-archives
               (or (alist-get value flutter-package-archives-alist)
                   (error "Unknown package archives: `%s'" value))))
  :type `(choice ,@(mapcar
                    (lambda (item)
                      (let ((name (car item)))
                        (list 'const
                              :tag (capitalize (symbol-name name))
                              name)))
                    flutter-package-archives-alist)))

(defcustom flutter-completion-style 'childframe
  "Completion display style."
  :group 'flutter
  :type '(choice (const :tag "Minibuffer" minibuffer)
                 (const :tag "Child Frame" childframe)))

(defcustom flutter-frame-maximized-on-startup nil
  "Maximize frame on startup or not."
  :group 'flutter
  :type 'boolean)

(defcustom flutter-dashboard (not (daemonp))
  "Display dashboard at startup or not.
If Non-nil, use dashboard, otherwise will restore previous session."
  :group 'flutter
  :type 'boolean)

(defcustom flutter-lsp t
  "Enable language server or not."
  :group 'flutter
  :type 'boolean)

(defcustom flutter-tree-sitter t
  "Enable tree-sitter or not.
Native tree-sitter is introduced in 29."
  :group 'flutter
  :type 'boolean)

(defcustom flutter-chinese-calendar nil
  "Enable Chinese calendar or not."
  :group 'flutter
  :type 'boolean)

(defcustom flutter-player t
  "Enable players or not.

Default flipped to t in Flutter Emacs because MPD is enabled on the
hosts (see modules/home/services/mpd.nix and the home.nix modules)."
  :group 'flutter
  :type 'boolean)

(defcustom flutter-prettify-symbols-alist
  '(("lambda" . ?λ)
    ("<-"     . ?←)
    ("->"     . ?→)
    ("->>"    . ?↠)
    ("=>"     . ?⇒)
    ("map"    . ?↦)
    ("/="     . ?≠)
    ("!="     . ?≠)
    ("=="     . ?≡)
    ("<="     . ?≤)
    (">="     . ?≥)
    ("=<<"    . (?= (Br . Bl) ?≪))
    (">>="    . (?≫ (Br . Bl) ?=))
    ("<=<"    . ?↢)
    (">=>"    . ?↣)
    ("&&"     . ?∧)
    ("||"     . ?∨)
    ("not"    . ?¬))
  "A list of symbol prettifications.
Nil to use font supports ligatures."
  :group 'flutter
  :type '(alist :key-type string :value-type (choice character sexp)))

;; Load `custom-file'
(setq custom-file (expand-file-name "custom.el" user-emacs-directory))

(provide 'init-custom)

