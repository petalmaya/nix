;;; Commentary:
;;
;; Structure:
;;   early-init.el            startup perf / frame / transparency
;;   init.el                  this file: bootstraps Elpaca, loads modules
;;   lisp/my-elpaca.el        Elpaca bootstrap + use-package integration
;;   vendor/centaur/lisp/     the absorbed Centaur Emacs modules
;;                            (centaur-* renamed to flutter-*; see
;;                            vendor/centaur/NOTICE.md)
;;   lisp/init-extras.el      QML + media extras carried from the old config
;;   custom.el / custom-post.el(.org)   your personal overrides
;;
;; Packages are installed by Elpaca (lisp/my-elpaca.el), never by Nix —
;; Nix only supplies the emacs binary and external tools.  The theme is
;; `flutterice' (themes/flutterice-theme.el), generated by matugen.
;;
;;; Code:

(when (version< emacs-version "28.1")
  (error "This requires Emacs 28.1 and above!"))

;; Speed up Startup Process
;; Optimize `auto-mode-alist'
(setq auto-mode-case-fold nil)

;;
;; Configure Load Path
;;

;; Add "lisp", "vendor/centaur/lisp" and "site-lisp" to the beginning of
;; `load-path'
(defun flutter/update-load-path (&rest _)
  "Prioritize the config's own load paths."
  (dolist (dir '("site-lisp" "lisp" "vendor/centaur/lisp"))
    (push (expand-file-name dir user-emacs-directory) load-path)))

;; Initialize load paths explicitly
(flutter/update-load-path)

;; The `flutterice' theme lives in this config's themes/ dir (generated
;; by matugen) — make it findable before init-ui.el loads it.
(add-to-list 'custom-theme-load-path
             (expand-file-name "themes" user-emacs-directory))

;; Rescan site-lisp subdirectories after package initialization
(defun flutter/add-subdirs-to-load-path (&rest _)
  "Recursively add subdirectories in `site-lisp' to `load-path'."
  (let ((default-directory (expand-file-name "site-lisp" user-emacs-directory)))
    (normal-top-level-add-subdirs-to-load-path)))

(advice-add #'package-initialize :after #'flutter/add-subdirs-to-load-path)

