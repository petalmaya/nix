# Sway — modular entry (swayfx + waybar/noctalia/quickshell variants)
# Main config simply includes the split files; order matters.
# Variables first so $mod etc are available to later files.
include ~/.config/sway/variables.conf
include ~/.config/sway/appearance.conf
include ~/.config/sway/inputs.conf
include ~/.config/sway/outputs.conf
include ~/.config/sway/bar.conf
include ~/.config/sway/keybinds.conf
include ~/.config/sway/media.conf
include ~/.config/sway/modes.conf
include ~/.config/sway/autostart.conf
# shell variant — waybar (default), noctalia, or quickshell (archived mango is separate)
# Generated by Nix (see modules/sway/default.nix); empty when waybar-only.
include ~/.config/sway/variant.conf
# matugen theme — generated at ~/.local/state/nixtop/theme/sway (fallback below)
include ~/.local/state/nixtop/theme/sway
