# mako — static structure only (no color keys here on purpose).
# Colors are generated by matugen at ~/.local/state/nixtop/theme/mako
# (see modules/matugen/templates/mako/config) and pulled in via the include
# below, so this file stays valid whether it is a store path or live-symlinked
# and matugen never writes into this directory. Behavioral keys live here;
# color keys live in the generated file, so neither side can fight the other.
include=~/.local/state/nixtop/theme/mako
font=FiraCode Nerd Font 10
border-size=2
border-radius=7
padding=14
margin=12
width=360
height=120
default-timeout=5000
icons=1
max-icon-size=48
anchor=top-right

[urgency=high]
default-timeout=0
